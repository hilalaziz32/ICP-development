{
  "_readme": {
    "what": "One entry per client. Maps a client to its outbound channels so tools and skills never have to ask for a token or a location ID.",
    "secrets": "NO CREDENTIALS LIVE HERE. Each channel names an MCP server; the API key / Private Integration Token is read at runtime from ~/.claude.json (outside the repo). Add a client's creds with `claude mcp add`, then reference the server name here.",
    "sms.workflow_prefix": "GHL sub-accounts get REUSED between clients. Tools scope to the client's own era = the earliest createdAt among workflows whose name starts with this prefix. Set era_start to override with a hard date.",
    "sms.locationId": "Found in the GHL URL when inside the sub-account: /v2/location/<THIS>/\u2026",
    "todo": "Clients with sms.locationId = null still need a Private Integration Token (Settings -> Private Integrations, read-only scopes) and their location ID."
  },
